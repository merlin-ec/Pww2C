# Copy to .env.local for local development. On Vercel, set these under
# Project Settings → Environment Variables. Never commit real secrets.

# --- Public (safe in the browser) ---------------------------------------------
# Supabase → Project Settings → API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: the public address used in auth email links. On Vercel it's
# detected automatically; set it once you have your own domain.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Secret (server only, never prefix with NEXT_PUBLIC_) ---------------------
# Supabase → Project Settings → API Keys → Secret keys (sb_secret_...)
SUPABASE_SECRET_KEY=
# TMDB → Settings → API → "API Read Access Token" (the long one)
TMDB_READ_TOKEN=
